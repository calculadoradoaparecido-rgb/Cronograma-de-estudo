{
  "name": "cronograma-de-estudo",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "preview_urls": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "trilha-panda-preview",
        "database_id": "ac2fb7bf-7eeb-421e-aebf-1413703b0e5d"
      }
    ]
  }
}
