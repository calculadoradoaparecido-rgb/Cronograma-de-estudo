{
  "name": "cronograma-de-estudo",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "MATERIALS", "bucket_name": "trilha-panda-materiais" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "trilha-panda-auth", "database_id": "6d2da478-4c2c-431b-97a7-79a9bab9fc2e" }
  ],
  "vars": {
    "APP_ORIGIN": "https://cronograma-de-estudo.ascf21052000.workers.dev"
  }
}
